# Server
SERVER_API_PREFIX=/api

# Datasource
DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
DATASOURCE_URL=jdbc:postgresql://localhost:5432/skAI-castle
DATASOURCE_USERNAME=your_db_username
DATASOURCE_PASSWORD=your_db_password

# JPA
JPA_SHOW_SQL=true
JPA_HIBERNATE_DDL_AUTO=none
SQL_INIT_OPT=always

# Mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# JWT
JWT_SECRET=your_jwt_secret_hex_64chars
JWT_ISSUER=skAI-castle-server
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80,https://your-domain.com

# AI Server
AI_SERVER_BASE_URL=http://localhost:8000
